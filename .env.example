# Copy to .env and fill in. .env is gitignored.

# Absolute path to the Obsidian vault root that contains the `vault/` folder.
# All raw, intermediate, and output files are written under
#   $OBSIDIAN_VAULT/vault/Private/Facebook/
OBSIDIAN_VAULT=/Users/you/Codes/personal/terry-obsidian

# Anthropic API key — used by classify (Haiku) and synthesize (Sonnet).
ANTHROPIC_API_KEY=sk-ant-...

# Embedding provider for the cluster stage. Pick ONE.
# Voyage (recommended for Korean text):
VOYAGE_API_KEY=
# OpenAI (fallback):
OPENAI_API_KEY=

# Optional: model overrides
FBPULL_CLASSIFY_MODEL=claude-haiku-4-5
FBPULL_SYNTHESIZE_MODEL=claude-sonnet-4-6
FBPULL_EMBED_MODEL=voyage-3
